# =======================================================
# AL BASEM — Unified Root Gitignore
# =======================================================

# Dependencies
node_modules/

# Environment configurations
# Never commit real environment files
.env
.env.*
!.env.example
!.env.sample

# Build & compilation outputs
dist/
dist-ssr/
build/
coverage/

# Local uploaded files
# Keep the directory structure but never commit uploaded data
backend/uploads/*
!backend/uploads/.gitkeep

# System / generated files
.system_generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?