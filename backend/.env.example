PORT=5000
NODE_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017/al_basem_db
JWT_SECRET=your_super_secret_jwt_key_min_16_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_min_16_characters
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
TIMEZONE=Asia/Dubai
CONTRACT_REMINDER_DAYS=30
CONTRACT_FINAL_REMINDER_DAYS=7
SERVICE_REMINDER_HOURS=24
PAYMENT_REMINDER_DAYS=3
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_min_8_characters
